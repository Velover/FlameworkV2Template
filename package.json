{
	"name": "flamework-plugin-template",
	"version": "0.1.0",
	"private": true,
	"description": "A Flamework v2 plugin package (package/) and the game that tests it in Studio.",
	"workspaces": ["package"],
	"scripts": {
		"build": "rbxtsc -p package && rbxtsc",
		"build:package": "rbxtsc -p package",
		"watch": "rbxtsc -w",
		"watch:package": "rbxtsc -p package -w",
		"serve": "rojo serve",
		"place": "rojo build -o place.rbxl",
		"test": "bun scripts/test.mjs",
		"format": "prettier --write src package/src"
	},
	"dependencies": {
		"@flamework-experimental/core": "2.0.0-alpha.6",
		"@flamework-experimental/testing": "2.0.0-alpha.6",
		"@rbxts/services": "^1.6.0",
		"@your-scope/player-events": "workspace:*"
	},
	"devDependencies": {
		"@flamework-experimental/transformer": "2.0.0-alpha.7",
		"@rbxts/compiler-types": "^3.0.0-types.0",
		"@rbxts/types": "^1.0.955",
		"prettier": "^3.8.1",
		"roblox-ts": "3.0.0",
		"typescript": "5.5.3"
	}
}
